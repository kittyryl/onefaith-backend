# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/onefaith

# Server Configuration
PORT=5000
NODE_ENV=development

# SMS Configuration
# Primary SMS provider: 'itexmo' (recommended for Philippines) or 'twilio'
SMS_ENABLED=false
SMS_PROVIDER=itexmo
SMS_FALLBACK_ENABLED=false

# Itexmo (Philippine SMS Provider - Recommended)
# Sign up at: https://www.itexmo.com
# Pricing: ₱0.15-0.50 per SMS
ITEXMO_API_CODE=your_api_code_here
ITEXMO_PASSWORD=your_password_here

# Twilio (International SMS Provider - Optional/Fallback)
# To enable SMS notifications for carwash service completion:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+1234567890
TWILIO_MESSAGING_SERVICE_SID=

# Note: 
# - Set SMS_ENABLED=true to activate SMS notifications
# - SMS_PROVIDER can be 'itexmo' or 'twilio' (default: itexmo)
# - Set SMS_FALLBACK_ENABLED=true to try alternate provider if primary fails
# - Itexmo: Get credentials from https://www.itexmo.com
# - Twilio: Get credentials from https://www.twilio.com/console
# - Philippine phone numbers will be automatically normalized (09XX -> +639XX)

# CORS (comma-separated list of allowed origins)
# Include your frontend origin(s)
# Example for Vercel frontend + local dev:
# CORS_ORIGIN=https://onefaith.vercel.app,http://localhost:3000
CORS_ORIGIN=
