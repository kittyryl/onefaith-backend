# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/onefaith

# Server Configuration
PORT=5000
NODE_ENV=development

# SMS Configuration
SMS_ENABLED=false
IPROG_API_TOKEN=your_api_token_here

# Note: 
# - Set SMS_ENABLED=true to activate SMS notifications
# - Uses IProg Tech only (₱1/SMS) - https://sms.iprogtech.com
# - Philippine phone numbers are automatically normalized (09XX -> +639XX)

# CORS (comma-separated list of allowed origins)
# Include your frontend origin(s)
# Example for Vercel frontend + local dev:
# CORS_ORIGIN=https://onefaith.vercel.app,http://localhost:3000
CORS_ORIGIN=
