# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/onefaith

# Server Configuration
PORT=5000
NODE_ENV=development

# SMS Configuration
# Primary SMS provider: 'iprog' (recommended), 'itexmo', or 'twilio'
SMS_ENABLED=false
SMS_PROVIDER=iprog
SMS_FALLBACK_ENABLED=false

# IProg Tech (Philippine SMS Provider - Recommended)
# Sign up at: https://sms.iprogtech.com/pricing
# Pricing: ₱1 per SMS (most affordable!)
IPROG_API_TOKEN=your_api_token_here

# Itexmo (Philippine SMS Provider - Alternative)
# Sign up at: https://www.itexmo.com
# Pricing: ₱0.15-0.50 per SMS
ITEXMO_API_CODE=your_api_code_here
ITEXMO_PASSWORD=your_password_here

# Twilio (International SMS Provider - Fallback)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+1234567890
TWILIO_MESSAGING_SERVICE_SID=

# Note: 
# - Set SMS_ENABLED=true to activate SMS notifications
# - SMS_PROVIDER options: 'iprog' (₱1/SMS), 'itexmo' (₱0.15-0.50/SMS), 'twilio' (₱0.40+/SMS)
# - Set SMS_FALLBACK_ENABLED=true to try alternate providers if primary fails
# - IProg: Simple, reliable, ₱1/SMS - https://sms.iprogtech.com
# - Itexmo: Cheapest, bulk-friendly - https://www.itexmo.com
# - Twilio: International, reliable - https://www.twilio.com/console
# - Philippine phone numbers will be automatically normalized (09XX -> +639XX)

# CORS (comma-separated list of allowed origins)
# Include your frontend origin(s)
# Example for Vercel frontend + local dev:
# CORS_ORIGIN=https://onefaith.vercel.app,http://localhost:3000
CORS_ORIGIN=
